1. Create Database and Tables:
SQL

CREATE DATABASE hospital_db;
\c hospital_db;

CREATE TABLE Patients (
    PatientID INT PRIMARY KEY,
    Name VARCHAR(255),
    Age INT,
    Gender VARCHAR(10),
    AdmissionDate DATE
);

CREATE TABLE Doctors (
    DoctorID INT PRIMARY KEY,
    Name VARCHAR(255),
    Specialization VARCHAR(255),
    Experience INT
);

